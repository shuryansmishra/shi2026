# Copy this file to .env and fill in what you have.
# Every value below already has a safe default in config.py,
# so the backend runs with an empty .env -- fill these in as they
# become available, not all at once.

# --- App ---
ENV=development
DEBUG=true

# --- LLM synthesis (optional) ---
# Leave ANTHROPIC_API_KEY blank to use the deterministic template
# answer generator instead of a real LLM call -- fully functional,
# just less fluent prose.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Vision engines ---
# Keep VQA_MOCK_MODE=true until you have trained checkpoints.
# The whole pipeline (router, evidence engine, API, frontend) is
# fully demoable in mock mode.
VQA_MOCK_MODE=true
VQA_MODEL_PATH=
CHANGE_MODEL_PATH=
FUSION_MODEL_PATH=

# --- ISRO Bhoonidhi data access ---
# Register at https://bhoonidhi.nrsc.gov.in and https://uops.nrsc.gov.in
# Approval isn't instant -- until you have these, use demo_data/ instead.
BHOONIDHI_USER=
BHOONIDHI_PASSWORD=
