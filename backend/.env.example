# SatQuery AI - Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# --- App Mode ---
VQA_MOCK_MODE=True  # Set to False only if you have real ML models ready
ENV=development     # development | production
DEBUG=True

# --- Security & CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000,https://*.vercel.app

# --- Storage ---
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
PUBLIC_STORAGE_DIR=./storage/public
MAX_UPLOAD_MB=200

# --- Database ---
DATABASE_URL=sqlite:///./satquery.db

# --- LLM Synthesis Layer ---
LLM_PROVIDER=local  # local | anthropic | openai | none
ANTHROPIC_API_KEY=              # Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=                 # Only needed if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o

# --- Vision Engines (ML Models) ---
# Set VQA_MOCK_MODE=False ONLY if you have trained checkpoints
VQA_MODEL_PATH=                 # e.g., ./checkpoints/qwen2.5-vl-lora
CHANGE_MODEL_PATH=              # e.g., ./checkpoints/vista-cdvqa
FUSION_MODEL_PATH=              # e.g., ./checkpoints/optical-sar-fusion

# --- Qwen 2.5 VL Configuration ---
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_REMOTE_URL=                # e.g., https://xxxx.ngrok-free.app (for Google Colab)
QWEN_USE_4BIT=True
QWEN_DEVICE=auto

# --- Geospatial Settings ---
TARGET_UTM_CRS=EPSG:32644       # UTM 44N (adjust to your AOI)
TILE_SIZE=512
TILE_OVERLAP=64
CHANGE_THRESHOLD=0.35
CLOUD_COVER_SAR_SWITCH_THRESHOLD=0.4

# --- ISRO Bhoonidhi Data Access ---
BHOONIDHI_USER=                 # NRSC Portal Username
BHOONIDHI_PASSWORD=             # NRSC Portal Password
